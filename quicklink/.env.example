NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-rotated-supabase-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-rotated-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/calendar/callback
RESEND_API_KEY=your-rotated-resend-api-key
EMAIL_FROM=Quicklink <notifications@your-verified-domain.com>
EMAIL_REPLY_TO=support@your-domain.com
# Local dev MUST use Stripe TEST keys (sk_test_... / whsec_... from
# `stripe listen`) here in this file. Stripe keys are intentionally NOT
# inherited from the parent folder's .env.local (see next.config.mjs) —
# using the live keys from there against a localhost origin is what causes
# "Livemode requests must always be redirected via HTTPS".
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Safe for browser use. Reserved for future embedded Stripe components;
# hosted Checkout works without it today.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:owner@your-domain.com
